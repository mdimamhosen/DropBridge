{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropBridge",
  "version": "0.1.1",
  "identifier": "dev.dropbridge.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DropBridge",
        "width": 960,
        "height": 680,
        "minWidth": 400,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Fast, encrypted file transfer between your devices",
    "longDescription": "DropBridge sends files, folders and text directly between Android, macOS, Windows and Linux over your local network. No account, no cloud, end-to-end encrypted.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
